# Widget Preview related
.widget_preview/

# Release signing — real secrets, must never be committed. The actual
# keystore file lives outside this project entirely (see key.properties'
# storeFile path) specifically so it can't accidentally end up in this
# repo even if this rule were ever removed.
/android/key.properties
*.jks
*.keystore
