<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card, same AppRadius.xl (20dp) as the app's own big cards
     (e.g. the plant photo frame). Colors are resource refs, not fixed hex
     — same file automatically re-resolves to the dark palette via
     values-night/colors_widget.xml, no separate drawable-night needed. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
</shape>
