<?xml version="1.0" encoding="utf-8"?>
<!-- v1, deliberately simple: one plant (the most urgent to water), name +
     status, tap anywhere to open the app. See
     WateringWidgetProvider.kt for what actually fills these in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_plant_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Momo" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12.5sp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Due today" />
</LinearLayout>
