<?xml version="1.0" encoding="utf-8"?>
<!-- Watering widget colors — mirrors AppColors in lib/theme/app_theme.dart
     exactly (surfaceLight/borderLight/textLight/textSecondaryLight/accent)
     so the widget reads as the same app, not a bolted-on extra. The dark
     variants live in values-night/colors_widget.xml with the same names;
     Android resolves which set applies automatically based on system dark
     mode, same as any other resource. -->
<resources>
    <color name="widget_surface">#FFFDF8</color>
    <color name="widget_border">#E9E2D2</color>
    <color name="widget_text_primary">#23281F</color>
    <color name="widget_text_secondary">#767F70</color>
    <color name="widget_accent">#C17A4F</color>
</resources>
